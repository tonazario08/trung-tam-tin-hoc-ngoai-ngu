// Prisma schema — Hệ thống Quản lý Trung tâm Tin học - Ngoại ngữ
// DB: PostgreSQL 16
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACADEMIC
  TEACHER
  STUDENT
}

enum StudentStatus {
  STUDYING
  RESERVED
  DROPPED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum CourseCategory {
  IT
  ENGLISH
  KOREAN
  JAPANESE
}

enum ClassStatus {
  OPEN
  RUNNING
  FINISHED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  RESERVED
  COMPLETED
  DROPPED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum GradeType {
  MIDTERM
  FINAL
  ASSIGNMENT
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QR
}

enum LeadStatus {
  NEW
  CONTACTED
  ENROLLED
  LOST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(STUDENT)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  teacher      Teacher?
  student      Student?
  notifications Notification[]
  leadsAssigned Lead[] @relation("LeadAssignee")
  gradesGiven  Grade[] @relation("GradeGrader")
  paymentsReceived Payment[] @relation("PaymentReceiver")

  @@map("users")
}

model Teacher {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  degree         String?
  hourlyRate     Decimal       @default(0) @db.Decimal(12, 2)
  status         TeacherStatus @default(ACTIVE)
  bio            String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  classes        Class[]

  @@map("teachers")
}

model Student {
  id             String        @id @default(cuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentCode    String        @unique
  fullName       String
  dob            DateTime?
  gender         String?
  phone          String?
  email          String?
  parentName     String?
  parentPhone    String?
  address        String?
  status         StudentStatus @default(STUDYING)
  enrollmentDate DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  enrollments    Enrollment[]
  invoices       Invoice[]
  certificates   Certificate[]

  @@index([phone])
  @@index([status])
  @@map("students")
}

model Course {
  id            String         @id @default(cuid())
  name          String
  category      CourseCategory
  level         String?
  durationWeeks Int            @default(12)
  totalSessions Int            @default(24)
  tuitionFee    Decimal        @default(0) @db.Decimal(12, 2)
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  classes       Class[]
  leads         Lead[]
  certificates  Certificate[]

  @@map("courses")
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int      @default(30)
  location  String?
  status    String   @default("AVAILABLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]
  schedules ClassSchedule[]

  @@map("rooms")
}

model Class {
  id          String      @id @default(cuid())
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id])
  teacherId   String?
  teacher     Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId      String?
  room        Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  classCode   String      @unique
  name        String
  maxStudents Int         @default(25)
  startDate   DateTime?
  endDate     DateTime?
  status      ClassStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  schedules   ClassSchedule[]
  enrollments Enrollment[]
  attendances Attendance[]

  @@index([courseId])
  @@index([status])
  @@map("classes")
}

model ClassSchedule {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  weekday   Int // 1=CN, 2=T2, ..., 7=T7
  startTime String // "18:00"
  endTime   String // "20:00"
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([classId])
  @@map("class_schedules")
}

model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId         String
  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrolledAt      DateTime         @default(now())
  status          EnrollmentStatus @default(ACTIVE)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  finalFee        Decimal          @default(0) @db.Decimal(12, 2)
  attendances     Attendance[]
  grades          Grade[]
  invoices        Invoice[]

  @@unique([studentId, classId, status], name: "uq_enrollment_active")
  @@index([studentId])
  @@index([classId])
  @@map("enrollments")
}

model Attendance {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classId      String
  class        Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionDate  DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([enrollmentId, sessionDate], name: "uq_attendance_session")
  @@index([classId, sessionDate])
  @@map("attendance")
}

model Grade {
  id           String    @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  type         GradeType
  score        Decimal   @db.Decimal(4, 2)
  comment      String?
  gradedById   String?
  gradedBy     User?     @relation("GradeGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt     DateTime  @default(now())

  @@index([enrollmentId])
  @@map("grades")
}

model Invoice {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId    String?
  enrollment      Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  invoiceCode     String        @unique
  totalAmount     Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  amountDue       Decimal       @db.Decimal(12, 2)
  dueDate         DateTime?
  status          InvoiceStatus @default(UNPAID)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payments        Payment[]

  @@index([studentId])
  @@index([status, dueDate])
  @@map("invoices")
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(CASH)
  paidAt       DateTime      @default(now())
  receivedById String?
  receivedBy   User?         @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  proofUrl     String?
  note         String?

  @@index([invoiceId])
  @@map("payments")
}

model Lead {
  id                 String     @id @default(cuid())
  fullName           String
  phone              String
  interestedCourseId String?
  interestedCourse   Course?    @relation(fields: [interestedCourseId], references: [id], onDelete: SetNull)
  source             String?
  status             LeadStatus @default(NEW)
  assignedToId       String?
  assignedTo         User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
  @@map("leads")
}

model Certificate {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  certificateCode String   @unique
  issuedDate      DateTime @default(now())
  fileUrl         String?

  @@map("certificates")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}
